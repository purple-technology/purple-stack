{
	"name": "purple-stack",
	"version": "4.0.0",
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"typecheck": "pnpm run -r typecheck",
		"test": "pnpm run -r test",
		"sst:deploy": "sst deploy --print-logs",
		"sst:remove": "sst remove --print-logs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@purple-stack/trpc-api": "workspace:*",
		"@purple-stack/transaction": "workspace:*",
		"@tsconfig/node22": "catalog:",
		"@types/aws-lambda": "catalog:",
		"typescript": "catalog:",
		"@types/node": "22.18.6"
	},
	"dependencies": {
		"@trpc/server": "catalog:",
		"sst": "catalog:"
	},
	"pnpm": {
		"overrides": {
			"fast-xml-parser@<5.5.6": ">=5.5.6",
			"picomatch@<4.0.4": ">=4.0.4",
			"path-to-regexp@<8.4.0": ">=8.4.0",
			"vite@<7.3.2": ">=7.3.2"
		}
	}
}
